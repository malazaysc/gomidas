{
  "name": "gomidas",
  "version": "0.1.0",
  "private": true,
  "description": "Gomidas monorepo root — see CLAUDE.md. Desktop app is CMake; these scripts drive the shared editor and the browser build.",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -C packages/core run build",
    "typecheck": "pnpm -C packages/core run typecheck",
    "sweep": "pnpm -C packages/core run sweep",
    "test": "pnpm -C packages/core run test",
    "web:dev": "pnpm -C apps/web run dev",
    "web:build": "pnpm -C apps/web run build",
    "web:preview": "pnpm -C apps/web run preview"
  }
}
