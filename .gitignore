build/
build-release/
*.o
*.obj
.DS_Store
compile_commands.json
*.gomidas.bak

# Node / Vitest (web layer unit tests — see docs/TESTING.md)
#
# Unanchored, so it matches at ANY depth. It used to name two specific paths, one of which
# (apps/packages/core/…) does not exist — with the result that apps/web/node_modules was tracked,
# 220 files of it. pnpm's store makes that worse, not better: symlinks into .pnpm are meaningless
# to anyone else's checkout.
node_modules/
.pnpm-store/
apps/packages/core/dist/
packages/core/coverage/

# Local Claude Code session artifacts (scheduled-task locks, etc.)
.claude/

# Large optional high-quality SoundFont (144MB, over GitHub's 100MB limit).
# Build falls back to the embedded sonivox bank when absent. See README "SoundFonts".
assets/soundfont/FluidR3_GM.sf2

# Samu project-local CLI config (holds an API token — never commit)
.samu/

# Generated by tsc from the TypeScript front-end (see web/tsconfig.json)
packages/core/dist/

# Production output of the browser app (apps/web/build.mjs) — ~19MB of copied assets
apps/web/dist/
