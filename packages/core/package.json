{
  "name": "gomidas-web",
  "version": "0.1.0",
  "private": true,
  "description": "Gomidas WebView layer \u2014 pure logic unit tests (Vitest). See docs/TESTING.md.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sweep": "node tools/checkjs-sweep.mjs",
    "test": "pnpm run build && vitest run",
    "test:watch": "pnpm run build && vitest",
    "coverage": "pnpm run build && vitest run --coverage"
  },
  "devDependencies": {
    "@coderline/alphatab": "^1.8.3",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
