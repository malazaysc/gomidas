{
  // GMD-68 — the dangling-reference sweep (see tools/checkjs-sweep.mjs).
  //
  // NOT `extends: ./tsconfig.json`, on purpose. This mirrors the exact flags of the CLI command
  // that was verified by hand, so the gate reports what that command reports:
  //     tsc --ignoreConfig --allowJs --checkJs --noEmit --target es2020 --skipLibCheck …
  // Extending the main config would drag in its `include` (all of core/**/*.ts), its outDir and
  // its strictness ratchets, mixing this check with the main build's concerns.
  //
  // `checkJs` is TRUE here and FALSE in the main build. That is the whole point: the main build
  // must not drown in the ~1400 inference diagnostics these files produce, but exactly one class
  // of them — TS2304, "Cannot find name" — is a real bug worth failing on. The runner filters.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2020",
    "skipLibCheck": true
  },

  // The plain-<script> files with no typecheck of their own. Vendored bundles stay out
  // (alphaTab.min.js is minified third-party; juce_native_interop.js must stay byte-identical).
  // The .ts files under core/ are already checked by the main build — including them here would
  // report their errors twice under different settings.
  "files": [
    "types/globals.d.ts",
    "app.js",
    "editor.js",
    "fretboard.js",
    "grooves.js",
    "core/gomidas-core.js"
  ]
}
